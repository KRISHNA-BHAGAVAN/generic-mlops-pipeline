{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mlops_api_request_total[1m]))",
          "legendFormat": "Total Requests"
        },
        {
          "expr": "sum(rate(mlops_api_request_total{status=~\"2..\"}[1m]))",
          "legendFormat": "Success (2xx)"
        },
        {
          "expr": "sum(rate(mlops_api_request_total{status=~\"5..\"}[1m]))",
          "legendFormat": "Errors (5xx)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Response Time (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(mlops_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(mlops_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(mlops_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(mlops_api_request_total{status=~\"5..\"}[5m])) / sum(rate(mlops_api_request_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Active Requests",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(mlops_api_requests_in_progress)",
          "legendFormat": "In Progress"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Prediction Errors (last 5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(mlops_prediction_errors_total[5m])",
          "legendFormat": "{{ error_type }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mlops", "system"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MLOps System Health",
  "uid": "mlops-system-health"
}
