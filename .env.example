# =============================================================================
# Generic MLOps Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- MLflow / DagsHub ---
# DagsHub MLflow tracking URI (format: https://dagshub.com/<username>/<repo>.mlflow)
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Default experiment name (optional, overridden by config)
MLFLOW_EXPERIMENT_NAME=generic-mlops-pipeline

# --- Database (PostgreSQL) ---
# Preferred: explicit SQLAlchemy URL
PREDICTION_DB_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops

# Optional: host/port pattern (URL built automatically if PREDICTION_DB_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlops
DB_USER=mlops
DB_PASSWORD=mlops

# Scheduler job store (defaults to PREDICTION_DB_URL if unset)
SCHEDULER_DB_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops

# --- Monitoring (Docker Compose) ---
# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=admin

# Prometheus pushgateway URL (for batch monitoring jobs)
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Developer identity label for Prometheus external_labels
PROMETHEUS_DEVELOPER=your-name

# --- Grafana Cloud (optional, for shared dashboards) ---
# Obtain these from Grafana Cloud portal → Prometheus tile → "Send Metrics"
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=
# Place the API token in: .secrets/grafana_cloud_metrics_token

# --- Alerting (Optional - Phase 1.2) ---
# Slack webhook URL for alerts (leave empty to disable)
SLACK_WEBHOOK_URL=

# --- Batch Monitoring Scheduler ---
BATCH_MONITOR_INTERVAL_HOURS=24.0
MONITORING_MODEL_NAME=
MONITORING_TASK_TYPE=regression
MONITORING_REFERENCE_DATA_PATH=
MONITORING_FEATURE_COLUMNS=
MONITORING_TARGET_COLUMN=target
MONITORING_LOOKBACK_HOURS=24

# --- Application ---
# FastAPI inference service port
APP_PORT=8000

# Prometheus metrics port (separate from app port)
PROMETHEUS_METRICS_PORT=8001

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO