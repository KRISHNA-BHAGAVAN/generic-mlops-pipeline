# =============================================================================
# Generic MLOps Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- MLflow / DagsHub ---
# DagsHub MLflow tracking URI (format: https://dagshub.com/<username>/<repo>.mlflow)
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Default experiment name (optional, overridden by config)
MLFLOW_EXPERIMENT_NAME=generic-mlops-pipeline

# --- Monitoring (Docker Compose) ---
# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=admin

# Prometheus pushgateway URL (for batch monitoring jobs)
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# --- Alerting (Optional - Phase 1.2) ---
# Slack webhook URL for alerts (leave empty to disable)
SLACK_WEBHOOK_URL=

# --- Application ---
# FastAPI inference service port
APP_PORT=8000

# Prometheus metrics port (separate from app port)
PROMETHEUS_METRICS_PORT=8001

# Prediction logging database
PREDICTION_DB_PATH=predictions.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
